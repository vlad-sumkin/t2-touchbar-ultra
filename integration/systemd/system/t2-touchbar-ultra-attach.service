[Unit]
Description=Attach the Apple T2 Touch Bar display interface

[Service]
Type=oneshot
ExecCondition=/usr/bin/systemctl --global is-enabled --quiet t2-touchbar-ultra.service
ExecStart=/usr/bin/t2-touchbar-ultra --attach
TimeoutStartSec=60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
