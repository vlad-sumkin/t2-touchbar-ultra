# Keep the non-desktop display and its touch digitizer away from the compositor;
# t2-touchbar-ultra opens this private seat directly.
SUBSYSTEM=="drm", KERNEL=="card*", DRIVERS=="t2bdrm|appletbdrm|adp", TAG-="master-of-seat", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar-ultra", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="Apple Inc. Touch Bar Display Touchpad", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar-ultra", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="Apple Inc. Touch Bar Display", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar-ultra", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="MacBookPro17,1 Touch Bar", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar-ultra", MODE="0660"
SUBSYSTEM=="input", ATTR{name}=="Mac14,7 Touch Bar", ENV{SYSTEMD_WANTS}="", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar-ultra", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Apple Inc. Touch Bar Display Touchpad", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar-ultra", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Apple Inc. Touch Bar Display", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar-ultra", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="MacBookPro17,1 Touch Bar", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar-ultra", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Mac14,7 Touch Bar", ENV{ID_SEAT}="seat-touchbar", GROUP="t2-touchbar-ultra", MODE="0660"

# The brightness controller is its own USB product (05ac:8102). Its driver
# takes a FULLON runtime-PM reference while lit and releases it after OFF, so
# permit autosuspend there. Never apply this to the 05ac:8302 display/touch
# device: the digitizer must remain awake for touch-to-wake.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8102", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="1000"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8102", TEST=="power/control", ATTR{power/control}="auto"

# Fn and keyboard activity come from the internal keyboard. Limit that event node
# to the dedicated device-access group.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="*Apple Internal Keyboard / Trackpad", GROUP="t2-touchbar-ultra", MODE="0660"

# Configuration 1 is the firmware key row; configuration 2 exposes the DRM
# display and touch digitizer. Keep this device awake: it owns touch-to-wake.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8302", ATTR{power/control}="on", ATTR{power/autosuspend_delay_ms}="-1"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8302", ATTR{bConfigurationValue}=="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="t2-touchbar-ultra-attach.service"

# Only members of t2-touchbar-ultra can alter Touch Bar illumination or inject virtual key events.
ACTION=="add|change", SUBSYSTEM=="backlight", KERNEL=="t2tb_backlight", RUN+="/bin/chgrp t2-touchbar-ultra /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
ACTION=="add|change", SUBSYSTEM=="backlight", KERNEL=="appletb_backlight", RUN+="/bin/chgrp t2-touchbar-ultra /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
SUBSYSTEM=="misc", KERNEL=="uinput", GROUP="t2-touchbar-ultra", MODE="0660"

# Fallback preset parameter access on t2_trackpad_actuator.
ACTION=="add|change", SUBSYSTEM=="hid", DRIVERS=="t2_trackpad_actuator", RUN+="/bin/chgrp t2-touchbar-ultra /sys/module/t2_trackpad_actuator/parameters/play", RUN+="/bin/chmod g+w /sys/module/t2_trackpad_actuator/parameters/play"

# Direct Report 0x53 waveform access on the T2 trackpad actuator hidraw node (add & change on resume).
ACTION=="add|change", SUBSYSTEM=="hidraw", DRIVERS=="t2_trackpad_actuator", ATTRS{id/vendor}=="05ac", ATTRS{id/product}=="0340", GROUP="t2-touchbar-ultra", MODE="0660"
